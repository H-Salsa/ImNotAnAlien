    - "Atra\xE7\xE3o: 9 m"
    - "Atra\xE7\xE3o: 12 m"
    - "Atra\xE7\xE3o: 16 m"
  - id: 1
    title: "For\xE7a Telecin\xE9tica"
    description: Levanta objetos mais pesados e arremessa mais forte.
    levelCosts: 1e0000003c00000064000000
    levelEffects:
    - Peso 2.500 kg, arremesso +15%
    - Peso 4.000 kg, arremesso +30%
    - Peso 6.000 kg, arremesso +50%
  - id: 2
    title: Alcance Mental
    description: "Alcan\xE7a alvos mais distantes com a telecinese."
    levelCosts: 1900000032000000
    levelEffects:
    - 'Alcance: 30 m'
    - 'Alcance: 35 m'
  - id: 3
    title: "Pele Alien\xEDgena"
    description: "Seu corpo fica mais resistente. (Ainda \xE9 humano. Juro.)"
    levelCosts: 1e0000003c0000005a000000
    levelEffects:
    - 'Vida: 130'
    - 'Vida: 160'
    - 'Vida: 200'
  - id: 4
    title: Devorar
